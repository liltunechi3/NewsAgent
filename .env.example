ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Optional: override the model used for summaries (default: claude-haiku-4-5)
# ANTHROPIC_MODEL=claude-haiku-4-5

# Recipient, international format without "+"
WHATSAPP_PHONE=62812345678
# Optional: send to a WhatsApp group instead (the sender device must be a member of the group).
# When set, this takes priority over WHATSAPP_PHONE. Format: 1234567890-1234567890@g.us
# WHATSAPP_GROUP_ID=

# Delivery provider: fonnte | wwebjs | console
#  fonnte  - hosted WhatsApp API (works on Vercel). Needs FONNTE_TOKEN
#  wwebjs  - WhatsApp Web automation (local machine / VPS only, QR scan on first run)
#  console - print the digest instead of sending
WHATSAPP_PROVIDER=fonnte
FONNTE_TOKEN=

# Vercel cron auth (Vercel sends it as "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=

# Optional tuning
# DB_PATH=./data/articles.db
# DIGEST_MAX=5
# MAX_AGE_HOURS=48
